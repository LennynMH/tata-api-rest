{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "users-api": {
      "type": "application",
      "root": "src/modules/users",
      "entryFile": "infrastructure/bootstrap/main",
      "sourceRoot": "src/modules/users",
      "compilerOptions": {
        "tsConfigPath": "src/modules/users/tsconfig.app.json"
      }
    },
    "packages-api": {
      "type": "application",
      "root": "src/modules/packages",
      "entryFile": "infrastructure/bootstrap/main",
      "sourceRoot": "src/modules/packages",
      "compilerOptions": {
        "tsConfigPath": "src/modules/packages/tsconfig.app.json"
      }
    },
    "tracking-api": {
      "type": "application",
      "root": "src/modules/tracking",
      "entryFile": "infrastructure/bootstrap/main",
      "sourceRoot": "src/modules/tracking",
      "compilerOptions": {
        "tsConfigPath": "src/modules/tracking/tsconfig.app.json"
      }
    }
  },
  "monorepo": true
}

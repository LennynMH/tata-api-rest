# Copiar como .env y configurar
# ==============================
# Server
PORT=2000
NODE_ENV=development
API_PREFIX=api

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=API Gestión de Envíos
SWAGGER_DESCRIPTION=API REST para sistema de gestión de envíos logísticos
SWAGGER_VERSION=1.0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=logistics_db

# Migrations
RUN_MIGRATIONS=true

# Health
HEALTH_DB_TIMEOUT_MS=1500

# Microservicios - URL de users-api (solo packages-api)
USERS_API_URL=http://localhost:2001

# MongoDB (NoSQL) - (seguimiento de paquetes)
MONGO_URI=mongodb://admin:admin123@localhost:27017/tracking_db?authSource=admin

# JWT (login en users-api; mismo secret en packages-api y tracking-api para validar token)
JWT_SECRET=tata-logistics-7xK9mP2nQ5vR8wY1zB4cF6hJ0sL3uW7xA9dG2eI5kM8pS1tV4yZ6bN0oC
JWT_EXPIRES_IN=30m
